# Cortext user service.
#
# Setup (per user, no root needed):
#   pip install --user .                      # installs `cortext`, `cortext-gui` and cortext.daemon
#   mkdir -p ~/.config/cortext ~/.local/share/cortext
#   mkdir -p ~/.config/systemd/user && cp packaging/systemd/cortext.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cortext
#
# Check:  systemctl --user status cortext   |   cortext logs -n 50
# Debug:  systemctl --user stop cortext && python3 -m cortext.daemon --diag
#
# The daemon is quiet by default: structured logs go to ~/.local/share/cortext/cortext.log
# (not the journal). It serves on $XDG_RUNTIME_DIR/cortext/cortext.sock (0600).
[Unit]
Description=Cortext cognitive working-memory daemon
After=network.target

[Service]
Type=simple
# Uses the python3 on the user's PATH, where `pip install --user` put the cortext package.
ExecStart=/usr/bin/env python3 -m cortext.daemon
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=cortext
ReadWritePaths=%h/.config/cortext %h/.local/share/cortext %t/cortext
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
